{
  "expo": {
    "name": "CutMySugar App",
    "slug": "cutmysugar",
    "scheme": "cutmysugar",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "package": "com.ritwik1994.cutmysugar"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ritwik1994.cutmysugar"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "CutMySugar",
      "shortName": "CutMySugar",
      "lang": "en",
      "startUrl": "/",
      "themeColor": "#ffffff",
      "backgroundColor": "#ffffff",
      "display": "standalone",
      "description": "Track your sugar intake and improve metabolic health.",
      "orientation": "portrait",
      "bumblebee": {
        "devTools": false
      },
      "meta": {
        "apple": {
          "mobileWebAppCapable": "yes",
          "mobileWebAppStatusBarStyle": "black-translucent",
          "touchIcon": "apple-touch-icon.png"
        }
      },
      "manifest": {
        "gcm_sender_id": "103953800507"
      }
    },
    "plugins": [
      "expo-web-browser",
      "expo-asset",
      "expo-notifications",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to access your camera to scan food labels."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "10e00d69-095f-4aa0-a185-e5bd40c8ed8d"
      }
    },
    "owner": "ritwik1994s-organization"
  }
}